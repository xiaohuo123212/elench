// 两个候选都是 O(n)，只是常数不同 —— `?!` 才有意义。
u64! rank(
          const vector<u64>& xs) {
    // 宿主必须有自己的逻辑（B-15），不能只写一句 return ?!kernel(xs);
    if (xs.size() == 0) {
        return 0;
    }
    return ?!kernel(xs);
} kernels kernel(
                 const vector<u64>& xs) -> u64! {
    by_scan {
        u64 best = 0;
        u64 i = 0;
        while (i < xs.size()) {
            best = max(best, xs.at(i));
            i = i + 1;
        }
        return best;
    }
    by_scan_rev {
        // 循环上界必须能静态推出：条件直接写 `i < xs.size()`，
        // 倒着取下标用 `xs.size() - 1 - i`，不要写 `while (i > 0)`。
        u64 best = 0;
        u64 i = 0;
        while (i < xs.size()) {
            best = max(best, xs.at(xs.size() - 1 - i));
            i = i + 1;
        }
        return best;
    }
}
