func top(const Vec<u64>& xs) -> u64! {
    if (xs.length() == 0) {
        return 0;
    }
    return ?!kernel(xs);
} kernels kernel(const Vec<u64>& xs) -> u64! {
    // 小 n 赢：无固定开销，每元素 6 次 max（斜率大）
    by_scan_heavy {
        u64 b = 0;
        u64 i = 0;
        while (i < xs.length()) {
            b = max(b, xs.at(i));
            b = max(b, xs.at(i));
            b = max(b, xs.at(i));
            b = max(b, xs.at(i));
            b = max(b, xs.at(i));
            b = max(b, xs.at(i));
            i = i + 1;
        }
        return b;
    }
    // 大 n 赢：先 3000 次迭代做准备（固定开销），之后每元素 1 次 max（斜率小）
    by_scan_setup {
        u64 warm = 0;
        while (warm < 3000) {
            warm = warm + 1;
        }
        u64 b = 0;
        u64 i = 0;
        while (i < xs.length()) {
            b = max(b, xs.at(i));
            i = i + 1;
        }
        return b;
    }
}
