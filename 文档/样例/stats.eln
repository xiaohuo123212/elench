// stats.eln —— 统计量（十个手写程序之四）的实现部分
//
// 手算期望值（写进 test_programs.py）：
//   summarize([1, 2, 3, 4])     → mean=2  variance=1  min=1  max=4
//   summarize([5])              → mean=5  variance=0  min=5  max=5
//   summarize([4, 1, 3, 2, 5])  → mean=3  variance=1  min=1  max=5（偏差和 6 / 5 = 1，整除）
//   summarize([10, 10, 10])     → mean=10 variance=0  min=10 max=10
//
// 方差用「平均绝对偏差」而不是平方偏差：平方会溢出 u64 的直觉范围，
// 而本语言还没有溢出 lint 的强约束。名字仍叫 variance，语义在注释里写清。
//
// 中间量一律非负：|x - mean| 用 if 分两支算，从写法上避开 i64 负数（E8 未修）。

// #region fn
pub Summary! summarize(
                   const vector<u64>& xs) {
    // 宿主局部名故意避开 `i` / `n`：候选默认 inline，能读宿主局部变量，
    // 若同名就是「遮蔽」——本语言禁止遮蔽（E-Name-Shadowed）。
    const u64 count = xs.size();
    if (count == 0) {
        return Err(StatsError::Empty);
    }

    // ---- 第一遍：求和（两条路，同阶不同常数）
    const u64 total = (?!sum_kernel(xs))?;
    const u64 mean = (total / count)?;

    // ---- 第二遍：平均绝对偏差 + 最大最小
    u64 diff_sum = 0;
    u64 min_value = xs.at(0);
    u64 max_value = xs.at(0);
    u64 idx = 0;
    while (idx < count) {
        const u64 x = xs.at(idx);

        // 中间量一律非负：|x - mean| 分两支算，避开 i64 负数（E8 未修）
        u64 d = 0;
        if (x > mean) {
            d = x - mean;
        } else {
            d = mean - x;
        }
        diff_sum = diff_sum + d;

        min_value = min(min_value, x);
        max_value = max(max_value, x);

        idx = idx + 1;
    }

    const u64 variance = (diff_sum / count)?;
    return Summary { mean: mean, variance: variance, min_value: min_value, max_value: max_value, };
} kernels sum_kernel(
                     const vector<u64>& xs) -> u64! {
    sum_forward {
        u64 s = 0;
        u64 i = 0;
        const u64 n = xs.size();
        while (i < n) {
            s = s + xs.at(i);
            i = i + 1;
        }
        return s;
    }
    // 反向累加也必须写成 `i < n` 的形状：T13 只认「与尺寸比较」的 while 条件，
    // `while (i > 0)` 递减推不出上界（会被 E-While-NoBound 挡住）。
    // 所以用前向计数器访问倒序下标——**上界可推，语义不变**。
    sum_backward {
        u64 s = 0;
        u64 i = 0;
        const u64 n = xs.size();
        while (i < n) {
            s = s + xs.at(n - 1 - i);
            i = i + 1;
        }
        return s;
    }
}
// #endregion fn
