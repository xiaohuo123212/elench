// paren.eln —— 括号匹配（十个手写程序之六）的实现部分
//
// 手算期望值（写进 test_programs.py）：
//   "()"        → 1（匹配）
//   "(())"      → 1
//   ""          → 1（空串视为匹配）
//   "(()"       → Err(Unclosed)
//   ")("        → Err(Unmatched)
//   65 层深      → Err(TooDeep)  ← array 容量 64，这是定长数组的边界
//
// 栈用 `array<u64, STACK_CAP>`：**push 超过 64 会被解释器拒绝**，
// 所以程序 MUST 自己先用 `length() >= STACK_CAP` 挡住——
// 这就是「定长数组」逼作者显式处理容量的地方。

// #region fn
pub func paren(
               const vector<u8>& text) -> u64! {
    array<u64,
    STACK_CAP> stack = array<u64,
    STACK_CAP>::make();
    u64 i = 0;
    const u64 n = text.length();

    while (i < n) {
        const u64 c = text.at(i);
        if (c == OPEN_PAREN) {
            // 定长栈：满了就是"嵌套太深"，不是崩溃
            if (stack.length() >= STACK_CAP) {
                return Err(ParenError::TooDeep);
            }
            stack.push(c);
        } else if (c == CLOSE_PAREN) {
            // requires 的履行：显式分支排除空栈（D6 第 2 条）
            if (stack.length() == 0) {
                return Err(ParenError::Unmatched);
            }
            const u64 top = stack.pop();
        }
        i = i + 1;
    }

    if (stack.length() != 0) {
        return Err(ParenError::Unclosed);
    }
    return 1;
}
// #endregion fn
