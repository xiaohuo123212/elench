// reverse_in.eln —— 双指针统计「不对称的对数」（纯读）
//
// 单计数器循环：`i` 一直加到 n，另一半用 `n - 1 - i` 现算。
// **为什么不用 `while (i + 1 < j)`**：两个变量同时在变，成本分析推不出上界（κ=⊤）。
// 换成单计数器后是 O(n)，对拍表里才有数——这也是样例要教的一件事。
pub func reverse_in(const vector<u64>& xs) -> u64 {
    u64 n = xs.length();
    u64 i = 0;
    u64 diff = 0;
    while (i < n) {
        u64 j = n - 1 - i;
        if (i < j) {
            if (xs[i] != xs[j]) { diff = diff + 1; }
        }
        i = i + 1;
    }
    return diff;
}
