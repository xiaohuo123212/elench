// count.eln —— 词频统计（十个手写程序之七）的实现部分
//
// 手算期望值（写进 test_programs.py）：
//   "aabbb"      → 3   （'b' 出现 3 次，最多）
//   "abcdef"     → 1   （每个都只出现 1 次）
//   ""           → Err(Empty)
//   "aaaa"       → 4
//   "1231"       → 2   （'1' 两次）
//
// 两个候选都返回「出现次数最多的那个字节的次数」：
//   freq_bucket   —— 256 个桶，单遍计数 + 256 次扫描，**O(n) 但有 256 的常数开销**
//   freq_pairwise —— 每个位置再扫一遍全串，**O(n²)，但没有初始化开销**
//
// 所以规模小的时候 freq_pairwise 更快，规模大的时候 freq_bucket 更快 ——
// **真实交叉点**，不是编出来的。

// #region fn
pub func count(
               const Vec<u8>& text) -> u64! {
    const u64 len = text.length();
    if (len == 0) {
        return Err(CountError::Empty);
    }
    return ?!freq_kernel(text);
} kernels freq_kernel(
                      const Vec<u8>& text) -> u64! {
    freq_bucket {
        // 定长桶数组：`filled(0)` 一次给足 BUCKET_COUNT 个零，直接可写
        FixedVec<u64,
        BUCKET_COUNT> buckets = FixedVec<u64,
        BUCKET_COUNT>::filled(0);

        const u64 n = text.length();
        u64 i = 0;
        while (i < n) {
            const u64 b = text.at(i);
            buckets[b] = buckets[b] + 1;
            i = i + 1;
        }

        u64 best = 0;
        u64 j = 0;
        while (j < BUCKET_COUNT) {
            best = max(best, buckets.at(j));
            j = j + 1;
        }
        return best;
    }
    freq_pairwise {
        const u64 n = text.length();
        u64 best = 0;
        u64 i = 0;
        while (i < n) {
            const u64 c = text.at(i);
            u64 cnt = 0;
            u64 j = 0;
            while (j < n) {
                if (text.at(j) == c) {
                    cnt = cnt + 1;
                }
                j = j + 1;
            }
            best = max(best, cnt);
            i = i + 1;
        }
        return best;
    }
}
// #endregion fn
