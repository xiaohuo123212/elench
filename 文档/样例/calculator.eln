// ============================================================
// calculator.ai —— 表达式求值器的实现
//
// v0.68 语法（全面 C++ 风格）：
//   func           函数关键字（参数后置，唯一刻意保留的非 C++ 处）
//   const T n      不可变绑定（类型前置）
//   T n            可变绑定
//   条件带括号     if (n == 0) { … }
//   块只用 }       不写 end
//   vector<T>         动态数组（会分配）
//   array<T, N> 定容数组（不分配）
//   T!             可能失败；错误类型取模块的 error 声明
//   return x       T! 函数里自动成为 Ok(x)——不要写 Ok(...)
//   调用可能失败   一律写 `?`
//
// 全部契约（cost / effects / target）见同目录 calculator.tu。
// ============================================================

pub i64! evaluate(
                  const vector<u8>& text) {
    const array<Token,
    MAX_TOKENS> tokens = tokenize(text)?;
    return reduce(tokens);
}

array<Token, MAX_TOKENS>! tokenize(
              const vector<u8>& text) {
    array<Token,
    MAX_TOKENS> tokens = array<Token,
    MAX_TOKENS>::make();
    u64 index = 0;
    const u64 total = text.size();

    while (index < total) {
        const u64 byte = text.at(index);

        if (byte == SPACE) {
            index = index + 1;
        } else if (byte == PLUS) {
            tokens.push_back(Token::Plus);
            index = index + 1;
        } else if (byte == MINUS) {
            tokens.push_back(Token::Minus);
            index = index + 1;
        } else if (byte == STAR) {
            tokens.push_back(Token::Star);
            index = index + 1;
        } else if (byte == SLASH) {
            tokens.push_back(Token::Slash);
            index = index + 1;
        } else if (byte == OPEN_PAREN) {
            tokens.push_back(Token::OpenParenthesis);
            index = index + 1;
        } else if (byte == CLOSE_PAREN) {
            tokens.push_back(Token::CloseParenthesis);
            index = index + 1;
        } else if (is_digit(byte)) {
            const (i64, u64) scanned = read_number(text, index)?;
            tokens.push_back(Token::Number(scanned.0));
            index = scanned.1;
        } else {
            return Err(CalcError::UnexpectedByte(index));
        }
    }

    if (tokens.size() == 0) {
        return Err(CalcError::EmptyExpression);
    }

    return tokens;
}

(i64, u64)! read_number(
                 const vector<u8>& text, u64 start) {
    u64 index = start;
    i64 value = 0;
    u64 digits = 0;

    while (more_digits(text, index)) {
        if (digits >= MAX_DIGITS) {
            return Err(CalcError::NumberTooLong);
        }
        const i64 digit = digit_value(text.at(index));
        value = value * 10;
        value = value + digit;
        index = index + 1;
        digits = digits + 1;
    }

    if (digits == 0) {
        return Err(CalcError::UnexpectedByte(start));
    }

    return (value, index);
}

i64! reduce(
            const array<Token, MAX_TOKENS>& tokens) {
    array<i64,
    MAX_DEPTH> values = array<i64,
    MAX_DEPTH>::make();
    array<Token,
    MAX_DEPTH> operators = array<Token,
    MAX_DEPTH>::make();
    u64 index = 0;
    const u64 total = tokens.size();

    while (index < total) {
        const Token token = tokens.at(index);

        match token {
            Token::Number(value) => {
                values.push_back(value);
            }
            ,
            Token::OpenParenthesis => {
                operators.push_back(token);
            }
            ,
            Token::CloseParenthesis => {
                const bool closed = pop_until_open(values, operators)?;
                if (!closed) {
                    return Err(CalcError::UnbalancedParenthesis);
                }
            }
            ,
            _ => {
                while (should_reduce(operators, token)) {
                    const i64 value = apply_top(& values, & operators)?;
                    values.push_back(value);
                }
                operators.push_back(token);
            }
            ,
        }

        index = index + 1;
    }

    while (operators.size() > 0) {
        const i64 value = apply_top(& values, & operators)?;
        values.push_back(value);
    }

    if (values.size() != 1) {
        return Err(CalcError::UnbalancedParenthesis);
    }

    return values.at(0);
}

bool! pop_until_open(array<i64, MAX_DEPTH>& values, array<Token,
                    MAX_DEPTH>& operators) {
    while (operators.size() > 0) {
        const Token top = operators.at(operators.size() - 1);
        if (top == Token::OpenParenthesis) {
            // pop 的 requires 由上一层分支与循环条件直接履行（T12 + T12-a）
            operators.pop();
            return true;
        }
        const i64 value = apply_top(values, operators)?;
        values.push_back(value);
    }

    return false;
}

bool should_reduce(
                   const array<Token, MAX_DEPTH>& operators, Token next) {
    if (operators.size() == 0) {
        return false;
    }

    const Token top = operators.at(operators.size() - 1);
    if (top == Token::OpenParenthesis) {
        return false;
    }

    return precedence(top) >= precedence(next);
}

u64 precedence(Token token) {
    match token {
        Token::Plus => return 1,
        Token::Minus => return 1,
        Token::Star => return 2,
        Token::Slash => return 2,
        _ => return 0,
    }
}

i64! apply_top(array<i64, MAX_DEPTH>& values, array<Token,
               MAX_DEPTH>& operators) {
    if (values.size() < 2 || operators.size() < 1) {
        return Err(CalcError::UnbalancedParenthesis);
    }

    // 下面三次 pop 的 requires（length >= 1）由上面的分支直接履行（T12 + T12-a），
    // 因此不再需要 `?`。这是标准库 API 按"前置条件优先"重设计后的写法。
    const Token operator = operators.pop();
    const i64 right = values.pop();
    const i64 left = values.pop();

    match operator {
        Token::Plus => return left + right,
        Token::Minus => return left - right,
        Token::Star => return left * right,
        Token::Slash => {
            if (right == 0) {
                return Err(CalcError::Arith(cause = Arithmetic::DivisionByZero));
            }
            // 除法返回普通整数；除零已在上面显式转成 CalcError，不需要 `?`。
            return left / right;
        }
        ,
        _ => return Err(CalcError::UnbalancedParenthesis),
    }
}

bool more_digits(
                  const vector<u8>& text, u64 index) {
    return index < text.size() && is_digit(text.at(index));
}

bool is_digit(u64 byte) {
    return byte >= ZERO && byte <= NINE;
}

i64 digit_value(u64 byte) {
    return (byte - ZERO) as i64;
}
