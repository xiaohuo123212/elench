// matrix3 —— 3×3 整数矩阵：乘法 / 转置 / 行列式 / 单位阵。
// 这是 main.cpp 的 Elench 转写（--compat）：只做「语言逼你改」的最小改动，改动逐条记在报告里。
//   R1  const int N = 3;                    → #define N 3      （E-Ai-HasDecl：.eln 里不许 const）
//   R2  i64 a[N][N];                        → std::array<i64, 9> a              （E-Type-NestedContainer：
//                                             array<array<T,3>,3> 直接拒绝，只能展平 + 下标换算 r*N+c；
//                                             顺带也解掉了 C 数组字段的 E-Struct-BodyForm。
//                                             长度必须写字面量：`array<i64, 3 * 3>` 会让 dsh cpp
//                                             出码时类型名变成 `array<i64, >` ⇒ E-Cxx-Unsupported）
//   R3  int cols[2];                        → std::array<i64, 2> cols
//   R4  x.at(r, k) / m.at(...)              → x.a[r][k] / m.a[...]              （const 形参上不能调成员函数）
//   （R5 撤掉：tag.c_str() 其实能用，出码落成 elench_s(tag)）
#include <cstdio>
#include <array>
#include <string>

typedef long long i64;

// 阶数：文件级常量，贯穿所有函数（行尾不能跟 // 注释：注释会进宏体）
#define N 3

struct Mat3 {
    std::array<i64, 9> a;

    void fill(i64 v) {
        for (int r = 0; r < N; ++r) {
            for (int c = 0; c < N; ++c) {
                a[r * N + c] = v;
            }
        }
    }

    void set(int r, int c, i64 v) { a[r * N + c] = v; }
    i64 at(int r, int c) const { return a[r * N + c]; }

    i64 trace() const {
        i64 s = 0;
        for (int r = 0; r < N; ++r) {
            s += a[r * N + r];
        }
        return s;
    }

    Mat3 transposed() const {
        Mat3 t;
        t.fill(0);
        for (int r = 0; r < N; ++r) {
            for (int c = 0; c < N; ++c) {
                t.a[c * N + r] = a[r * N + c];
            }
        }
        return t;
    }

    // 行列式：沿第一行做余子式展开。第 c 列的余子式吃掉「跳过 c 之后
    // 剩下的两列」，这两列必须按原来的先后次序排，否则符号会翻错。
    i64 det() const {
        i64 total = 0;
        for (int c = 0; c < N; ++c) {
            std::array<i64, 2> cols;
            int k = 0;
            for (int j = 0; j < N; ++j) {
                if (j != c) {
                    cols[k] = j;
                    k += 1;
                }
            }
            i64 minor = a[1 * N + cols[0]] * a[2 * N + cols[1]] - a[1 * N + cols[1]] * a[2 * N + cols[0]];
            i64 term = a[c] * minor;
            if (c % 2 == 0) {
                total += term;
            } else {
                total -= term;
            }
        }
        return total;
    }

    bool equals(const Mat3& o) const {
        for (int r = 0; r < N; ++r) {
            for (int c = 0; c < N; ++c) {
                if (a[r * N + c] != o.a[r * N + c]) {
                    return false;
                }
            }
        }
        return true;
    }
};

static Mat3 identity() {
    Mat3 m;
    m.fill(0);
    for (int r = 0; r < N; ++r) {
        m.set(r, r, 1);
    }
    return m;
}

// 矩阵乘法：三层循环，中间量 xik 提到最内层外面，免得重复取值。
static Mat3 mul(const Mat3& x, const Mat3& y) {
    Mat3 out;
    out.fill(0);
    for (int r = 0; r < N; ++r) {
        for (int k = 0; k < N; ++k) {
            i64 xik = x.a[r * N + k];
            for (int c = 0; c < N; ++c) {
                out.a[r * N + c] += xik * y.a[k * N + c];
            }
        }
    }
    return out;
}

static void dump(const std::string& tag, const Mat3& m) {
    std::printf("%s\n", tag);
    for (int r = 0; r < N; ++r) {
        std::printf("  %lld   %lld   %lld\n", m.a[r * N], m.a[r * N + 1], m.a[r * N + 2]);
    }
}

int main() {
    Mat3 m;
    m.fill(0);
    m.set(0, 0, 2); m.set(0, 1, -1); m.set(0, 2, 3);
    m.set(1, 0, 0); m.set(1, 1, 4); m.set(1, 2, 1);
    m.set(2, 0, 5); m.set(2, 1, 2); m.set(2, 2, -2);
    dump("M =", m);
    std::printf("trace(M) = %lld\n", m.trace());
    std::printf("det(M)   = %lld\n", m.det());

    Mat3 t = m.transposed();
    dump("M^T =", t);
    std::printf("det(M^T) = %lld\n", t.det());

    Mat3 id = identity();
    Mat3 mi = mul(m, id);
    std::printf("det(I)   = %lld\n", id.det());
    std::printf("trace(I) = %lld\n", id.trace());
    if (mi.equals(m)) {
        std::printf("M * I == M\n");
    } else {
        std::printf("M * I != M\n");
    }

    Mat3 mmt = mul(m, t);
    dump("M * M^T =", mmt);
    std::printf("trace(M*M^T) = %lld\n", mmt.trace());

    // 上三角矩阵：det 应当就是对角线乘积 1
    Mat3 u;
    u.fill(0);
    u.set(0, 0, 1); u.set(0, 1, 2); u.set(0, 2, 3);
    u.set(1, 0, 0); u.set(1, 1, 1); u.set(1, 2, 2);
    u.set(2, 0, 0); u.set(2, 1, 0); u.set(2, 2, 1);
    std::printf("det(U)   = %lld (expect 1)\n", u.det());
    std::printf("trace(U) = %lld (expect 3)\n", u.trace());
    if (u.equals(id)) {
        std::printf("U == I\n");
    } else {
        std::printf("U != I (det alone does not decide)\n");
    }
    return 0;
}
