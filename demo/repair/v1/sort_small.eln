// v1：手写插入排序 —— **违反声明**（n² > n log n）
//
// 这段代码"看起来对、测起来也对"，但阶是错的：门禁会在**不运行**的前提下拦住它。

u64 sort_small(Vec<u64>& xs) {
    u64 i = 1;
    while (i < xs.size()) {
        u64 j = i;
        while (j > 0) {
            if (xs[j - 1] > xs[j]) {
                const u64 t = xs[j - 1];
                xs[j - 1] = xs[j];
                xs[j] = t;
                j = j - 1;
            } else {
                j = 0;
            }
        }
        i = i + 1;
    }
    return xs.size();
}
