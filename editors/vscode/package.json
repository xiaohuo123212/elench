{
  "name": "elench",
  "displayName": "Elench",
  "description": "Elench（.eln / .tu）：语法高亮 + 内置解释器。拖进 VS Code 即可检查、算成本、跑门禁、直接运行。",
  "version": "0.4.0",
  "publisher": "elench",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaohuo123212/ai-lang-design"
  },
  "contributes": {
    "languages": [
      {
        "id": "elench",
        "aliases": [
          "Elench",
          "elench"
        ],
        "extensions": [
          ".eln",
          ".tu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "elench",
        "scopeName": "source.elench",
        "path": "./syntaxes/eln.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "elench.run",
        "title": "Elench: 运行当前程序"
      },
      {
        "command": "elench.check",
        "title": "Elench: 检查当前文件"
      },
      {
        "command": "elench.cost",
        "title": "Elench: 显示成本上界"
      },
      {
        "command": "elench.build",
        "title": "Elench: 构建（门禁）"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "elench.run",
          "when": "resourceExtname == .eln || resourceExtname == .tu",
          "group": "navigation@1"
        },
        {
          "command": "elench.check",
          "when": "resourceExtname == .eln || resourceExtname == .tu",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Elench",
      "properties": {
        "elench.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "运行内置解释器用的 Python（3.10+）；Windows 上如果 python 不在 PATH，可填 py 或 python3"
        },
        "elench.dshPath": {
          "type": "string",
          "default": "",
          "description": "src/dsh.py 的路径；留空则在当前工作区里自动找"
        },
        "elench.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存时自动运行 dsh check 并把诊断写进 Problems"
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:elench",
    "onCommand:elench.run"
  ]
}
